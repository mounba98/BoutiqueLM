rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Products (Public read, authenticated write)
    match /artifacts/{appId}/public/data/products/{productId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Config/Settings: contiene SOLO la chiave Gemini dell'AI Stylist.
    // La lettura è pubblica perché l'AI Stylist gira nel browser dei visitatori: la chiave va
    // quindi LIMITATA nella Google Cloud Console (referrer HTTP = dominio del sito, solo API
    // Generative Language, quota giornaliera). Scrittura solo per l'admin.
    match /artifacts/{appId}/config/settings {
      allow read: if true;
      allow write: if isAuth();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
